generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model Client {
  id        String   @id @default(uuid())
  shortId   Int      @unique @default(autoincrement())
  surname   String
  name      String
  email     String
  phone     String
  sites     Site[]
  createdAt DateTime @default(now())
}

model Site {
  id           String        @id @default(uuid())
  shortId      Int           @unique @default(autoincrement())
  name         String
  address      String
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id])
  transmitters Transmitter[]
  obLogs       ObLog[]
}

model Transmitter {
  id            String   @id @default(uuid())
  referenceCode String   @unique          // 🔑 transmitter ID
  siteId        String
  site          Site     @relation(fields: [siteId], references: [id])
  alarms        Alarm[]
}

model Alarm {
  id            String       @id @default(uuid())
  shortId       Int          @unique @default(autoincrement())
  source        String
  eventType     String
  triggeredAt   DateTime
  zone          String

  transmitterId String
  transmitter   Transmitter  @relation(fields: [transmitterId], references: [id])

  aiCalls       AiCall[]
  dispatch      Dispatch?
}

model AiCall {
  id              String    @id @default(uuid())
  shortId         Int       @unique @default(autoincrement())
  alarmId         String
  alarm           Alarm     @relation(fields: [alarmId], references: [id])
  calledAt        DateTime  @default(now())
  callDuration    String?
  notes           String?
  aiDecision      String?
  confidenceScore Float?
  evaluatedAt     DateTime?
}

model Dispatch {
  id            String    @id @default(uuid())
  shortId       Int       @unique @default(autoincrement())
  dispatchedAt  DateTime
  arrivalTime   DateTime?
  resolvedAt    DateTime?
  responseNotes String?

  alarmId String @unique
  alarm   Alarm  @relation(fields: [alarmId], references: [id])

  guardId String?
  guard   Guard?  @relation(fields: [guardId], references: [id])

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
}

model ObLog {
  id        String   @id @default(uuid())
  shortId   Int      @unique @default(autoincrement())
  logTime   DateTime
  actionLog String
  notes     String
  guardId   String?
  guard     Guard?   @relation(fields: [guardId], references: [id])
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id])
}

model User {
  id        String    @id @default(uuid())
  shortId   Int       @unique @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  createdAt DateTime  @default(now())
  lastLogin DateTime?

  roleId String
  role   UserRole @relation(fields: [roleId], references: [id])
}

model UserRole {
  id    String @id
  name  String @unique
  users User[]
}

model Vehicle {
  id          String  @id @default(uuid())
  shortId     Int     @unique @default(autoincrement())
  name        String
  plate       String  @unique
  model       String
  status      String
  description String?

  dispatches Dispatch[]
  guards     Guard[]
}

model Guard {
  id      String @id @default(uuid())
  shortId Int    @unique @default(autoincrement())
  name    String
  phone   String
  status  String

  assignedVehicleId String?
  assignedVehicle   Vehicle? @relation(fields: [assignedVehicleId], references: [id])

  dispatches Dispatch[]
  obLogs     ObLog[]
}
