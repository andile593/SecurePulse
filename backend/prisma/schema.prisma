content://com.android.externalstorage.documents/tree/primary%3ADownload%2FSecurePulse::primary:Download/SecurePulse/backend/prisma/schema.prismagenerator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id           String @id @default(uuid())
  name         String
  contactEmail String
  phone        String
  sites        Site[]
  createdAt    DateTime @default(now())
}

model Site {
  id        String  @id @default(uuid())
  name      String
  address   String
  latitude  Float
  longitude Float
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id])
  company   Company?  @relation(fields: [companyId], references: [id])
  alarms    Alarm[]
 }

model Alarm {
  id          String    @id @default(uuid())
  triggeredAt DateTime
  alarmType   String
  priority    Int
  status      String
  siteId      String
  site        Site      @relation(fields: [siteId], references: [id])
  obLogs      ObLog[]
  aiCall      AiCall?
  dispatch    Dispatch?
}"

model ObLog {
  id      String   @id @default(uuid())
  logTime DateTime
  message String
  source  String
  alarmId String?
  alarm   Alarm?    @relation(fields: [alarmId], references: [id])
  guardId String?
  guard   Guard?   @relation(fields: [guardId], references: [id])
}

model AiCall {
  id              String   @id @default(uuid())
  aiDecision      String
  confidenceScore Float
  evaluatedAt     DateTime
  notes           String?

  alarmId String @unique
  alarm   Alarm  @relation(fields: [alarmId], references: [id])
}

model Dispatch {
  id            String    @id @default(uuid())
  dispatchedAt  DateTime
  arrivalTime   DateTime?
  resolvedAt    DateTime?
  responseNotes String?

  alarmId String @unique
  alarm   Alarm  @relation(fields: [alarmId], references: [id])

  guardId String?
  guard   Guard?  @relation(fields: [guardId], references: [id])

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  name        String
  role        Role     @default(CONTROLLER)
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  resetToken       String? 
  resetTokenExpiry DateTime?

}


model UserRole {
  id    String @id @default(uuid())
  name  String @unique 
  users User[]
}

model Company {
  id      String  @id @default(uuid())
  name    String
  users   User[]
  sites   Site[]
}


model Vehicle {
  id         String   @id @default(uuid())
  name       String
  plate      String  @unique
  model      String
  status     String
  description String?

  dispatches Dispatch[]
  guards     Guard[]
}

model Guard {
  id     String @id @default(uuid())
  name   String
  phone  String
  status String

  assignedVehicleId String?
  assignedVehicle   Vehicle? @relation(fields: [assignedVehicleId], references: [id])

  dispatches Dispatch[]
  obLogs     ObLog[] 
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CONTROLLER
  CLIENT
  GUARD
}