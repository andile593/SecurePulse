generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id        String   @id @default(uuid())
  shortId   Int      @default(autoincrement()) @unique
  surname   String
  name      String
  email     String
  phone     String
  sites     Site[]
  alarms    Alarm[] 
  createdAt DateTime @default(now())
}

model Site {
  id        String  @id @default(uuid())
  shortId   Int      @default(autoincrement()) @unique
  name      String
  address   String
  latitude  Float
  longitude Float
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id])
  alarms    Alarm[]
}

model Alarm {
  id            String   @id @default(uuid())
  shortId   Int      @default(autoincrement()) @unique
  triggeredAt   DateTime
  eventType     String
  priority      Int
  status        String
  source        String

  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  resolutionNotes String?
  resolvedBy      String?
  resolvedAt      DateTime?

  lastAICheckAt DateTime?
  aiDecision    String?

  aiCalls   AiCall[]
  dispatch Dispatch?
}

model ObLog {
  id      String   @id @default(uuid())
  shortId   Int      @default(autoincrement()) @unique
  logTime DateTime
  message String
  source  String
  guardId String?
  guard   Guard?   @relation(fields: [guardId], references: [id])
}

model AiCall {
  id              String   @id @default(uuid())
  shortId   Int      @default(autoincrement()) @unique
  aiDecision      String
  confidenceScore Float
  evaluatedAt     DateTime
  notes           String?

  alarmId String 
  alarm   Alarm  @relation(fields: [alarmId], references: [id])
}

model Dispatch {
  id            String    @id @default(uuid())
  shortId   Int      @default(autoincrement()) @unique
  dispatchedAt  DateTime
  arrivalTime   DateTime?
  resolvedAt    DateTime?
  responseNotes String?

  alarmId String @unique
  alarm   Alarm  @relation(fields: [alarmId], references: [id])

  guardId String?
  guard   Guard?  @relation(fields: [guardId], references: [id])

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
}

model User {
  id        String    @id @default(uuid())
  shortId   Int      @default(autoincrement()) @unique
  email     String    @unique
  password  String
  name      String
  createdAt DateTime  @default(now())
  lastLogin DateTime?

  roleId String
  role   UserRole @relation(fields: [roleId], references: [id])
}

model UserRole {
  id    String @id
  name  String @unique
  users User[]
}

model Vehicle {
  id          String  @id @default(uuid())
  shortId   Int      @default(autoincrement()) @unique
  name        String
  plate       String  @unique
  model       String
  status      String
  description String?

  dispatches Dispatch[]
  guards     Guard[]
}

model Guard {
  id     String @id @default(uuid())
  shortId   Int      @default(autoincrement()) @unique
  name   String
  phone  String
  status String

  assignedVehicleId String?
  assignedVehicle   Vehicle? @relation(fields: [assignedVehicleId], references: [id])

  dispatches Dispatch[]
  obLogs     ObLog[]
}
