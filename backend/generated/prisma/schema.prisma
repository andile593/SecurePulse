generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id        String   @id @default(uuid())
  shortId   Int      @unique @default(autoincrement())
  surname   String
  name      String
  email     String
  phone     String
  createdAt DateTime @default(now())
  sites     Site[]
}

model Site {
  id       String @id @default(uuid())
  shortId  Int    @unique @default(autoincrement())
  name     String
  address  String
  clientId String

  client       Client        @relation(fields: [clientId], references: [id])
  transmitters Transmitter[]
  OBLogs       OBLog[]
}

model Transmitter {
  id            String @id @default(uuid())
  referenceCode String @unique
  siteId        String

  site   Site    @relation(fields: [siteId], references: [id])
  alarms Alarm[]
}

model Alarm {
  id            String   @id @default(uuid())
  shortId       Int      @unique @default(autoincrement())
  triggeredAt   DateTime
  eventType     String
  source        String
  transmitterId String

  transmitter Transmitter @relation(fields: [transmitterId], references: [id])
  aiCalls     AiCall[]
  dispatch    Dispatch?
}

model AiCall {
  id              String    @id @default(uuid())
  shortId         Int       @unique @default(autoincrement())
  alarmId         String
  calledAt        DateTime  @default(now())
  callDuration    String?
  notes           String?
  aiDecision      String?
  confidenceScore Float?
  evaluatedAt     DateTime?
  phone           String?
  alarm           Alarm     @relation(fields: [alarmId], references: [id])
}

model Dispatch {
  id            String    @id @default(uuid())
  shortId       Int       @unique @default(autoincrement())
  dispatchedAt  DateTime
  arrivalTime   DateTime?
  resolvedAt    DateTime?
  responseNotes String?
  alarmId       String    @unique
  guardId       String?
  vehicleId     String?

  alarm   Alarm    @relation(fields: [alarmId], references: [id])
  guard   Guard?   @relation(fields: [guardId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
}

model OBLog {
  id        String   @id @default(uuid())
  shortId   Int      @unique @default(autoincrement())
  logTime   DateTime
  guardId   String?
  siteId    String?
  actionLog String
  notes     String

  guard Guard? @relation(fields: [guardId], references: [id])
  site  Site?  @relation(fields: [siteId], references: [id])
}

model User {
  id        String    @id @default(uuid())
  shortId   Int       @unique @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  createdAt DateTime  @default(now())
  lastLogin DateTime?
  roleId    String

  role Role @relation(fields: [roleId], references: [id])
}

model Role {
  id   String @id
  name String @unique

  users User[]
}

model Vehicle {
  id      String @id @default(uuid())
  shortId Int    @unique @default(autoincrement())
  name    String
  plate   String @unique
  model   String
  status  String

  dispatches Dispatch[]
  guards     Guard[]
}

model Guard {
  id                String  @id @default(uuid())
  shortId           Int     @unique @default(autoincrement())
  name              String
  phone             String
  status            String
  assignedVehicleId String?

  assignedVehicle Vehicle?   @relation(fields: [assignedVehicleId], references: [id])
  dispatches      Dispatch[]
  OBLogs          OBLog[]
}
